{
  "manifest_version": 1,
  "type": "device",
  "name": "Meteoclimatic",
  "description": {
    "en": "Readings of the Meteoclimatic amateur weather stations (Spain, Portugal, Andorra) in Gladys.",
    "fr": "Les relevés des stations météo amateurs Meteoclimatic (Espagne, Portugal, Andorre) dans Gladys.",
    "de": "Die Messwerte der Meteoclimatic-Amateurwetterstationen (Spanien, Portugal, Andorra) in Gladys.",
    "es": "Las lecturas de las estaciones meteorológicas aficionadas Meteoclimatic (España, Portugal, Andorra)."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-meteoclimatic:1.0.0",
  "gladys_version": ">=5.2.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-meteoclimatic/main/cover.png",
  "categories": ["environment"],
  "transports": ["cloud"],
  "location": true,
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Meteoclimatic stations",
        "fr": "Stations Meteoclimatic",
        "de": "Meteoclimatic-Stationen",
        "es": "Estaciones de Meteoclimatic"
      },
      "description": {
        "en": "Meteoclimatic is a network of amateur weather stations in Spain, Portugal and Andorra. Its data is open (CC BY-NC-ND licence), no account needed. Not affiliated with Meteoclimatic.",
        "fr": "Meteoclimatic est un réseau de stations météo amateurs en Espagne, au Portugal et en Andorre. Ses données sont ouvertes (licence CC BY-NC-ND), sans compte. Non affilié à Meteoclimatic.",
        "de": "Meteoclimatic ist ein Netz von Amateurwetterstationen in Spanien, Portugal und Andorra. Seine Daten sind offen (Lizenz CC BY-NC-ND), ohne Konto. Nicht mit Meteoclimatic verbunden.",
        "es": "Meteoclimatic es una red de estaciones meteorológicas aficionadas de España, Portugal y Andorra. Sus datos son abiertos (licencia CC BY-NC-ND), sin cuenta. No afiliado a Meteoclimatic."
      },
      "links": [
        {
          "url": "https://www.meteoclimatic.net/",
          "label": {
            "en": "Meteoclimatic map",
            "fr": "Carte Meteoclimatic",
            "de": "Meteoclimatic-Karte",
            "es": "Mapa de Meteoclimatic"
          }
        }
      ]
    },
    {
      "key": "stations",
      "type": "string",
      "label": {
        "en": "Stations",
        "fr": "Stations",
        "de": "Stationen",
        "es": "Estaciones"
      },
      "description": {
        "en": "The codes of the stations to read, separated by commas (10 at most). The code ends the address of the station page (…/perfil/ESCAT0800000008350A). The \"Find stations near a house\" button below lists those around you.",
        "fr": "Les codes des stations à lire, séparés par des virgules (10 au plus). Le code termine l'adresse de la page de la station (…/perfil/ESCAT0800000008350A). Le bouton « Trouver les stations autour d'une maison » ci-dessous liste celles qui vous entourent.",
        "de": "Die Codes der zu lesenden Stationen, durch Kommas getrennt (höchstens 10). Der Code steht am Ende der Adresse der Stationsseite (…/perfil/ESCAT0800000008350A). Der Button „Stationen um ein Haus finden“ unten listet die in deiner Nähe auf.",
        "es": "Los códigos de las estaciones que desea leer, separados por comas (10 como máximo). El código termina la dirección de la página de la estación (…/perfil/ESCAT0800000008350A). El botón «Buscar estaciones alrededor de una casa» más abajo lista las de su zona."
      },
      "placeholder": {
        "en": "e.g. ESCAT0800000008350A",
        "fr": "ex. ESCAT0800000008350A",
        "de": "z. B. ESCAT0800000008350A",
        "es": "p. ej. ESCAT0800000008350A"
      },
      "required": false
    },
    {
      "key": "refresh_minutes",
      "type": "select",
      "label": {
        "en": "Reading interval",
        "fr": "Fréquence de lecture",
        "de": "Leseintervall",
        "es": "Frecuencia de lectura"
      },
      "description": {
        "en": "The stations upload about every 10 minutes; Meteoclimatic is a volunteer network: 10 minutes is the fastest.",
        "fr": "Les stations envoient leurs relevés toutes les 10 minutes environ ; Meteoclimatic est un réseau bénévole : 10 minutes au plus vite.",
        "de": "Die Stationen senden etwa alle 10 Minuten; Meteoclimatic ist ein ehrenamtliches Netz: höchstens alle 10 Minuten.",
        "es": "Las estaciones envían sus lecturas cada 10 minutos aproximadamente; Meteoclimatic es una red de voluntarios: 10 minutos como mínimo."
      },
      "required": false,
      "default": "15",
      "options": [
        {
          "value": "10",
          "label": {
            "en": "Every 10 minutes",
            "fr": "Toutes les 10 minutes",
            "de": "Alle 10 Minuten",
            "es": "Cada 10 minutos"
          }
        },
        {
          "value": "15",
          "label": {
            "en": "Every 15 minutes",
            "fr": "Toutes les 15 minutes",
            "de": "Alle 15 Minuten",
            "es": "Cada 15 minutos"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "Every 30 minutes",
            "fr": "Toutes les 30 minutes",
            "de": "Alle 30 Minuten",
            "es": "Cada 30 minutos"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "Every hour",
            "fr": "Toutes les heures",
            "de": "Jede Stunde",
            "es": "Cada hora"
          }
        }
      ]
    },
