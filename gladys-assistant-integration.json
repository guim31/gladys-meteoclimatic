  "actions": [
    {
      "key": "find_nearby",
      "label": {
        "en": "Find stations near a house",
        "fr": "Trouver les stations autour d'une maison",
        "de": "Stationen um ein Haus finden",
        "es": "Buscar estaciones alrededor de una casa"
      },
      "description": {
        "en": "Lists the stations online around the house, nearest first, with their codes.",
        "fr": "Liste les stations en ligne autour de la maison, de la plus proche à la plus lointaine, avec leurs codes.",
        "de": "Listet die Stationen online um das Haus auf, die nächste zuerst, mit ihren Codes.",
        "es": "Lista las estaciones conectadas alrededor de la casa, de la más cercana a la más lejana, con sus códigos."
      },
      "timeout_seconds": 60,
      "fields": [
        {
          "key": "house",
          "type": "select",
          "source": "houses",
          "label": {
            "en": "House",
            "fr": "Maison",
            "de": "Haus",
            "es": "Casa"
          },
